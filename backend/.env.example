# Copy to .env (dev) / .env.production (prod) and fill in real values. Never commit the filled file.

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/codesnbytes_sales?schema=public"
PORT=4500
JWT_SECRET="change-me-to-a-long-random-string"

# Comma-separated admin emails allowed to bootstrap the first super admin via /api/admin/bootstrap
BOOTSTRAP_ADMIN_EMAILS="kcperiyon@gmail.com"

# Public base URL of this app, used to build referral links like https://codesnbytes.moneyvarsity.net/go/<code>
APP_BASE_URL="https://codesnbytes.moneyvarsity.net"
